{
    "name": "@sigx/ssr-islands",
    "version": "0.4.2",
    "description": "Islands architecture for SignalX SSR — selective hydration via client:* directives",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./client": {
            "import": "./dist/client/index.js",
            "types": "./dist/client/index.d.ts"
        },
        "./server": {
            "import": "./dist/server/index.js",
            "types": "./dist/server/index.d.ts"
        },
        "./jsx": {
            "types": "./src/jsx.d.ts"
        }
    },
    "files": [
        "dist",
        "src/jsx.d.ts"
    ],
    "scripts": {
        "build": "vite build && tsgo --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "ssr",
        "islands",
        "hydration",
        "selective-hydration",
        "client-directives",
        "server-side-rendering"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ssr-islands.git",
        "directory": "packages/ssr-islands"
    },
    "homepage": "https://sigx.dev/ssg/",
    "bugs": {
        "url": "https://github.com/signalxjs/ssr-islands/issues"
    },
    "dependencies": {
        "@sigx/server-renderer": "^0.4.9"
    },
    "peerDependencies": {
        "sigx": "^0.4.9"
    },
    "devDependencies": {
        "@sigx/vite": "^0.4.9",
        "@types/node": "^22.19.1",
        "sigx": "^0.4.9",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
