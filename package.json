{
  "name": "sigx-ssr-islands-monorepo",
  "version": "0.4.2",
  "private": true,
  "description": "Islands architecture for SignalX SSR — selective hydration via client:* directives",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint packages/ssr-islands/src",
    "lint:fix": "oxlint --fix packages/ssr-islands/src",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js",
    "publish:beta": "node scripts/publish.js --tag beta",
    "version:set": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.47.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "SignalX",
    "sigx",
    "ssr",
    "islands",
    "hydration",
    "selective-hydration"
  ],
  "author": "Andreas Ekdahl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalxjs/ssr-islands.git"
  },
  "homepage": "https://github.com/signalxjs/ssr-islands",
  "bugs": {
    "url": "https://github.com/signalxjs/ssr-islands/issues"
  },
  "packageManager": "pnpm@10.28.2"
}
